{
  "name": "particle-sim",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Parcacik hizlandirma ve isinlama simulatoru / Particle acceleration and irradiation simulator",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "vite build --base ./ --outDir dist-offline --emptyOutDir && node scripts/inline-offline.mjs dist-offline",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node scripts/build-data/index.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "i18next": "^24.0.0",
    "postprocessing": "^6.36.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-i18next": "^15.0.0",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^22.10.0",
    "@types/d3-shape": "^3.1.6",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
